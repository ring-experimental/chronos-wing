<rml>
<head><link type="text/rcss" href="ui.rcss"/><title>gamepad</title></head>
<body class="modal" data-model="ui">
  <div class="panel wide">
    <h1>게임패드 키 설정</h1>
    <!-- 줄 순서는 host/gamepad.c의 ACTIONS를 따른다. 왼쪽 스틱은 언제나 이동이다. -->
    <div class="binds">
      <button class="bind" data-for="b : binds" data-event-click="bind_start(it_index)"><span>{{b.name}}</span><span class="key">{{capture == it_index ? '누르세요' : b.key}}</span></button>
    </div>
    <div class="buttons">
      <button data-event-click="bind_reset">초기화</button>
      <button data-event-click="close_binds">닫기</button>
    </div>
  </div>
</body>
</rml>
