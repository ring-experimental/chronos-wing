/* 게임 위에 얹는 UI. 1dp는 게임 화면 1픽셀(높이 320 기준)이다. */
body { font-family: Pretendard; font-size: 12dp; color: #fff; width: 100%; height: 100%; position: absolute; top: 0; left: 0; }
div, span, h1, button, input { display: block; }
span { display: inline-block; }

.group { position: absolute; }
.group.edit { background-color: #ffffff30; border-radius: 0.15em; }
.group.selected { background-color: #ffc83d80; }

/* 스킨 이미지는 work/tools/mkskin.py로 만든다. 게임 메뉴의 남색과 금색, 로고의 톱니를 따른다. */
.btn {
  position: absolute; left: 0; top: 0; width: 1em; height: 1em; line-height: 1em; text-align: center;
  color: #faf0cd; font-effect: outline(1.2dp #0a162e);
}
.dial { position: absolute; left: 0; top: 0; width: 3em; height: 3em; decorator: image(dial.png); }
.arrow.up { decorator: image(a_up.png); }
.arrow.up.on { decorator: image(a_up_on.png); }
.arrow.down { decorator: image(a_down.png); }
.arrow.down.on { decorator: image(a_down_on.png); }
.arrow.left { decorator: image(a_left.png); }
.arrow.left.on { decorator: image(a_left_on.png); }
.arrow.right { decorator: image(a_right.png); }
.arrow.right.on { decorator: image(a_right_on.png); }

.orb { width: 1.6em; height: 1.6em; decorator: image(orb.png); }
.orb.on { decorator: image(orb_on.png); }
.skill { decorator: image(skill.png); }
.skill.on { decorator: image(skill_on.png); }
.small { width: 0.8em; height: 0.8em; decorator: image(small.png); }
.small.on { decorator: image(small_on.png); }
.icon { position: absolute; left: 0.17em; top: 0.17em; width: 0.46em; height: 0.46em; }
.i-bag { decorator: image(i_bag.png); }
.i-map { decorator: image(i_map.png); }
.i-menu { decorator: image(i_menu.png); }
.i-gear { decorator: image(i_gear.png); }
.pill { width: 1.6em; height: 0.8em; decorator: image(pill.png); }
.pill.on { decorator: image(pill_on.png); }
/* 글자 칸을 버튼 전체로 잡는다. line-height는 글자 자신의 크기 기준이라 버튼 높이 / 글자 크기로 쓴다. */
.btn .n, .btn .t { display: block; width: 100%; height: 100%; text-align: center; }
.orb .n { font-size: 0.56em; line-height: 2.857em; }
.skill .n { font-size: 0.56em; line-height: 1.786em; }
.pill .t { font-size: 0.36em; line-height: 2.222em; }

.modal { background-color: #000000aa; z-index: 10; }
.panel { position: absolute; left: 50%; top: 50%; width: 260dp; margin-left: -130dp; margin-top: -90dp; padding: 12dp; background-color: #183c70f5; border: 2dp #f8c400; border-radius: 6dp; box-sizing: border-box; }
h1 { font-size: 15dp; margin-bottom: 12dp; text-align: center; }
.row { height: 26dp; line-height: 22dp; margin-bottom: 4dp; }
.row span { width: 70dp; }
.buttons { margin-top: 10dp; text-align: center; }
button { display: inline-block; height: 26dp; line-height: 24dp; padding: 0 10dp; margin: 0 3dp; background-color: #305ca8; border: 1dp #f8c400; border-radius: 3dp; text-align: center; }
button:hover { background-color: #3f73c8; }
button:active { background-color: #6b8fc7; }

input.range { display: inline-block; width: 150dp; height: 20dp; vertical-align: middle; }
input.range slidertrack { height: 6dp; margin-top: 7dp; background-color: #0a162e; border-radius: 3dp; }
input.range sliderbar { width: 14dp; height: 20dp; background-color: #f8c400; border-radius: 3dp; }
input.range sliderbar:active { background-color: #d5e4f8; }
input.range sliderarrowdec, input.range sliderarrowinc { width: 0; height: 0; }
input.checkbox { display: inline-block; width: 20dp; height: 20dp; background-color: #0d1420; border: 1dp #7f9fc9; border-radius: 3dp; vertical-align: middle; }
input.checkbox:checked { background-color: #f8c400; }

/* 막대 밖은 패드 묶음을 끌 수 있게 통과시킨다. */
.editbar-root { pointer-events: none; z-index: 10; }
.editbar { pointer-events: auto; position: absolute; top: 4dp; left: 50%; width: 320dp; margin-left: -160dp; height: 32dp; line-height: 28dp; padding: 2dp 6dp; background-color: #183c70f5; border: 2dp #f8c400; border-radius: 6dp; box-sizing: border-box; text-align: center; }
.editbar span { width: 140dp; font-size: 10dp; pointer-events: auto; }
.editbar button { pointer-events: auto; }
