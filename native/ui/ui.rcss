/* 게임 위에 얹는 UI. 1dp는 게임 화면 1픽셀(높이 320 기준)이다. */
body { font-family: ChronosGame; font-size: 11dp; color: #fff; width: 100%; height: 100%; position: absolute; top: 0; left: 0; }
div, span, h1, button, input { display: block; }
span { display: inline-block; }

.group { position: absolute; }
.group.edit { background-color: #ffffff30; border-radius: 0.15em; }
.group.selected { background-color: #ffc83d80; }

/* 스킨 이미지는 work/tools/mkskin.py로 만든다. 게임 메뉴의 남색과 금색, 로고의 톱니를 따른다. */
.btn {
  position: absolute; left: 0; top: 0; width: 1em; height: 1em; line-height: 1em; text-align: center;
  color: #faf0cd; font-effect: outline(1.2dp #0a162e);
}
.dial { position: absolute; left: 0; top: 0; width: 3em; height: 3em; decorator: image(dial.png); }
.arrow.up { decorator: image(a_up.png); }
.arrow.up.on { decorator: image(a_up_on.png); }
.arrow.down { decorator: image(a_down.png); }
.arrow.down.on { decorator: image(a_down_on.png); }
.arrow.left { decorator: image(a_left.png); }
.arrow.left.on { decorator: image(a_left_on.png); }
.arrow.right { decorator: image(a_right.png); }
.arrow.right.on { decorator: image(a_right_on.png); }

.orb { width: 1.6em; height: 1.6em; decorator: image(orb.png); }
.orb.on { decorator: image(orb_on.png); }
.skill { decorator: image(skill.png); }
.skill.on { decorator: image(skill_on.png); }
.small { width: 0.8em; height: 0.8em; decorator: image(small.png); }
.small.on { decorator: image(small_on.png); }
.item { decorator: image(small.png); }
.item.on { decorator: image(small_on.png); }
.icon { position: absolute; left: 0.17em; top: 0.17em; width: 0.46em; height: 0.46em; }
.item .icon { left: 0.2em; top: 0.2em; width: 0.6em; height: 0.6em; }
.i-bag { decorator: image(i_bag.png); }
.i-map { decorator: image(i_map.png); }
.i-menu { decorator: image(i_menu.png); }
.i-gear { decorator: image(i_gear.png); }
.i-save { decorator: image(i_save.png); }
.pill { width: 1.6em; height: 0.8em; decorator: image(pill.png); }
.pill.on { decorator: image(pill_on.png); }
/* 글자 칸을 버튼 전체로 잡는다. line-height는 글자 자신의 크기 기준이라 버튼 높이 / 글자 크기로 쓴다. */
.btn .n, .btn .t { display: block; width: 100%; height: 100%; text-align: center; }
.orb .n { font-size: 0.647em; line-height: 2.473em; }
/* 가변폭 글자는 오른쪽에 1픽셀 여백이 있어 한 글자 버튼은 그만큼 민다. */
.skill .n { font-size: 0.647em; line-height: 1.546em; padding-left: 2dp; box-sizing: border-box; }
.pill .t { font-size: 0.647em; line-height: 1.236em; }
.small .n { font-size: 0.5em; line-height: 1.6em; padding-left: 2dp; box-sizing: border-box; }

/* 설정 화면과 편집 막대는 글자 크기(em)와 비율로 잡아 화면과 글자에 맞춰 늘어난다. */
.modal { background-color: #000000aa; z-index: 10; display: flex; justify-content: center; align-items: center; }
.panel { width: 24em; max-width: 92%; padding: 1em; background-color: #183c70f5; border: 0.18em #f8c400; border-radius: 0.5em; box-sizing: border-box; }
h1 { margin-bottom: 1em; text-align: center; }
.row { display: flex; align-items: center; min-height: 2.2em; margin-bottom: 0.4em; }
.row span { flex: 0 0 28%; }
.buttons { display: flex; margin-top: 0.8em; }
button { flex: 1 1 auto; height: 2.2em; line-height: 2.2em; padding: 0 0.8em; margin: 0 0.25em; background-color: #305ca8; border: 0.09em #f8c400; border-radius: 0.3em; text-align: center; box-sizing: border-box; }
button:hover { background-color: #3f73c8; }
button:active { background-color: #6b8fc7; }

input.range { display: block; flex: 1 1 auto; height: 1.8em; }
input.range slidertrack { height: 0.5em; margin-top: 0.65em; background-color: #0a162e; border-radius: 0.25em; }
input.range sliderbar { width: 1.2em; height: 1.8em; background-color: #f8c400; border-radius: 0.25em; }
input.range sliderbar:active { background-color: #d5e4f8; }
input.range sliderarrowdec, input.range sliderarrowinc { width: 0; height: 0; }
input.checkbox { display: block; width: 1.8em; height: 1.8em; background-color: #0a162e; border: 0.09em #f8c400; border-radius: 0.25em; box-sizing: border-box; }
input.checkbox:checked { background-color: #f8c400; }

/* 막대 밖은 패드 묶음을 끌 수 있게 통과시킨다. */
.editbar-root { pointer-events: none; z-index: 10; display: flex; justify-content: center; align-items: flex-end; }
.editbar { pointer-events: auto; display: flex; align-items: center; width: 62%; height: 2.8em; margin-bottom: 0.4em; padding: 0 0.3em; background-color: #183c70f5; border: 0.18em #f8c400; border-radius: 0.5em; box-sizing: border-box; }
.editbar span { flex: 1 1 auto; text-align: center; pointer-events: auto; }
.editbar button { flex: 0 0 auto; pointer-events: auto; }
